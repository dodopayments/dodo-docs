{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "declaration": true,
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**", "node_modules"]
}
